---
import CoverPreview from "@components/CoverPreview.astro"
import Footer from "@components/Footer.astro"
import Header from "@components/Header.astro"
import Search from "@components/Search.astro"
import { SITE } from "@config"
import Layout from "@layouts/Layout.astro"
import Main from "@layouts/Main.astro"
import { getPosts, getTopics } from "@utils/posts"

const posts = await getPosts()
const suggestions = getTopics(posts)
  .slice(0, 6)
  .map(topic => topic.name)
---

<Layout title={`Search | ${SITE.title}`}>
  <Header activeNav="search" />
  <Main
    pageTitle="搜索"
    pageTitleEn="Search"
    eyebrow="Find — 检索"
    meta={`${posts.length} entries indexed`}
  >
    <Search posts={posts} suggestions={suggestions} />
  </Main>
  <Footer />
  <CoverPreview />
</Layout>
