---
import { marked } from "marked"

export type Props = {
  text: string
}

const { text } = Astro.props
const content = marked.parse(text)
---

<aside class="callout">
  <span class="mark" aria-hidden="true">※</span>
  <div class="content" set:html={content} />
</aside>

<style>
  .callout {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    margin-block: 2em;
    padding: 1.1rem 1.25rem;
    background: var(--paper-2);
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.92em;
    line-height: 1.85;
  }
  .mark {
    color: var(--accent);
    line-height: inherit;
  }
  .content :global(p) {
    margin: 0;
    text-align: left;
  }
  .content :global(p + p) {
    margin-top: 0.5em;
  }
</style>
