---
import { Image } from "astro:assets"
import { formatNumber } from "@utils/format"
import type { Post } from "@utils/posts"

export interface Props {
  post: Post
  index: number
}

const { post, index } = Astro.props
const { title, description, tags, cover } = post.data
---

<article class="feature" style={`--i:${index}`}>
  <a href={post.href} class="feature-link">
    {
      cover && (
        <div class="cover feature-cover" transition:name={`cover-${post.slug}`}>
          <Image
            src={cover}
            alt=""
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 64rem) 50vw, 100vw"
            format="webp"
            loading="lazy"
          />
        </div>
      )
    }
    <div class="feature-meta caps">
      <span class="feature-no">№ {formatNumber(post.number)}</span>
      <span>{tags.join(" / ")}</span>
      <span>{post.year}</span>
    </div>
    <h3 class="feature-title" lang={post.lang}>{title}</h3>
    <p class="feature-desc" lang={post.lang}>{description}</p>
  </a>
</article>

<style>
  .feature-link {
    display: block;
  }
  .feature-cover {
    aspect-ratio: var(--ratio, 4 / 3);
    border-radius: 2px;
  }
  .feature-meta {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .feature-no {
    color: var(--accent);
  }
  .feature-meta span:last-child {
    margin-left: auto;
  }
  .feature-title {
    margin-top: 1rem;
    font-size: var(--step-2);
    line-height: 1.3;
    font-weight: 500;
    transition: color 0.3s;
  }
  .feature-link:hover .feature-title {
    color: var(--accent);
  }
  .feature-desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0.75rem;
    font-size: var(--step--1);
    line-height: 1.8;
    color: var(--muted);
    max-width: 36rem;
  }
</style>
